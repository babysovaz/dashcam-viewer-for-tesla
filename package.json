{
  "name": "dashcam-viewer-for-tesla",
  "productName": "Dashcam Viewer for Tesla",
  "version": "0.5.0",
  "description": "Lecteur multi-caméras des clips dashcam/Sentinelle Tesla, avec déchiffrement local des clips 2026.20+.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/container.test.js",
